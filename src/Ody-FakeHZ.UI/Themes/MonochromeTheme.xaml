<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Monochrome Color Palette -->
    
    <!-- Black -->
    <Color x:Key="ColorBlack">#000000</Color>
    <SolidColorBrush x:Key="BrushBlack" Color="{StaticResource ColorBlack}"/>
    
    <!-- White -->
    <Color x:Key="ColorWhite">#FFFFFF</Color>
    <SolidColorBrush x:Key="BrushWhite" Color="{StaticResource ColorWhite}"/>
    
    <!-- Gray Scale -->
    <Color x:Key="ColorGray10">#1A1A1A</Color>
    <SolidColorBrush x:Key="BrushGray10" Color="{StaticResource ColorGray10}"/>
    
    <Color x:Key="ColorGray20">#333333</Color>
    <SolidColorBrush x:Key="BrushGray20" Color="{StaticResource ColorGray20}"/>
    
    <Color x:Key="ColorGray30">#4D4D4D</Color>
    <SolidColorBrush x:Key="BrushGray30" Color="{StaticResource ColorGray30}"/>
    
    <Color x:Key="ColorGray40">#666666</Color>
    <SolidColorBrush x:Key="BrushGray40" Color="{StaticResource ColorGray40}"/>
    
    <Color x:Key="ColorGray50">#808080</Color>
    <SolidColorBrush x:Key="BrushGray50" Color="{StaticResource ColorGray50}"/>
    
    <Color x:Key="ColorGray60">#999999</Color>
    <SolidColorBrush x:Key="BrushGray60" Color="{StaticResource ColorGray60}"/>
    
    <Color x:Key="ColorGray70">#B3B3B3</Color>
    <SolidColorBrush x:Key="BrushGray70" Color="{StaticResource ColorGray70}"/>
    
    <Color x:Key="ColorGray80">#CCCCCC</Color>
    <SolidColorBrush x:Key="BrushGray80" Color="{StaticResource ColorGray80}"/>
    
    <Color x:Key="ColorGray90">#E6E6E6</Color>
    <SolidColorBrush x:Key="BrushGray90" Color="{StaticResource ColorGray90}"/>

    <!-- Semantic Colors -->
    <StaticResource x:Key="AppBackgroundBrush" ResourceKey="BrushBlack"/>
    <StaticResource x:Key="SurfaceBrush" ResourceKey="BrushGray10"/>
    <StaticResource x:Key="SurfaceElevatedBrush" ResourceKey="BrushGray20"/>
    <StaticResource x:Key="BorderBrush" ResourceKey="BrushGray30"/>
    <StaticResource x:Key="AccentBrush" ResourceKey="BrushGray60"/>
    <StaticResource x:Key="TextPrimaryBrush" ResourceKey="BrushWhite"/>
    <StaticResource x:Key="TextSecondaryBrush" ResourceKey="BrushGray70"/>
    <StaticResource x:Key="TextDisabledBrush" ResourceKey="BrushGray50"/>

    <!-- Storyboards for Smooth Animations -->
    
    <!-- Fade In Animation -->
    <Storyboard x:Key="FadeInStoryboard">
        <DoubleAnimation
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Fade Out Animation -->
    <Storyboard x:Key="FadeOutStoryboard">
        <DoubleAnimation
            Storyboard.TargetProperty="Opacity"
            From="1" To="0"
            Duration="0:0:0.2">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseIn"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Slide In From Left -->
    <Storyboard x:Key="SlideInFromLeftStoryboard">
        <DoubleAnimation
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
            From="-100" To="0"
            Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Button Styles -->
    <Style x:Key="MonochromeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <TransitionCollection>
                    <RepositionThemeTransition/>
                </TransitionCollection>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource MonochromeButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BrushWhite}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushBlack}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Toggle Switch Style -->
    <Style x:Key="MonochromeToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="OffContent" Value=""/>
        <Setter Property="OnContent" Value=""/>
    </Style>

    <!-- TextBlock Styles -->
    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SubheaderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Profile Card Style -->
    <Style x:Key="ProfileCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="MinHeight" Value="80"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <TransitionCollection>
                    <RepositionThemeTransition/>
                </TransitionCollection>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
